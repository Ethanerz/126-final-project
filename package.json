{
  "name": "rate-upv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src next.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "node scripts/verify-database.mjs",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:db && npm run test:e2e && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10",
    "react-router-dom": "7.18.4",
    "supabase": "^2.121.0",
    "typescript": "6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.8"
  },
  "imports": {
    "#components/*": "./src/components/*",
    "#lib/*": "./src/lib/*"
  }
